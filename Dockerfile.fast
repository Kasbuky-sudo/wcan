FROM docker.1ms.run/library/python:3.11-slim

# === APT 加速（阿里云 Debian 源，x86 + arm64 通用） ===
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list

# === 时区配置（轻量版，仅时区不含NTP） ===
ENV TZ=Asia/Shanghai
RUN apt-get update && \
    apt-get install -y --no-install-recommends tzdata && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制字体文件
# 商业字体不入库（版权）。如需服务端中文字体，将 ttf 放到构建目录后取消注释：
# COPY 仿宋_GB2312.ttf /usr/share/fonts/
# COPY simhei.ttf /usr/share/fonts/

# 复制pip配置和requirements文件
COPY pip.conf /etc/pip.conf
COPY requirements.txt .

# pip 安装（阿里云首选，清华/华为备用，自动兼容 x86 + arm64）
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ -r requirements.txt || \
    pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple/ -r requirements.txt || \
    pip install --no-cache-dir -i https://mirrors.huaweicloud.com/pypi/simple/ -r requirements.txt || \
    pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY . .

# 创建必要的目录并设置权限
RUN mkdir -p /app/文章 && \
    chmod 755 /app/文章 && \
    chmod +x /app/run.py /app/entrypoint.sh

# 暴露端口
EXPOSE 10015

# 启动命令（bash 前缀绕开 Windows 文件无执行权限问题）
CMD ["bash", "/app/entrypoint.sh"]
