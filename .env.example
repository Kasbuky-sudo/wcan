# 复制为 .env 后填写真实值（docker compose 会自动读取同目录的 .env）
#   cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到 GitHub

# 会话与加密密钥 —— 必须设置，生成方式：
#   openssl rand -hex 32
# 注意：WebDAV / 邮箱密码用它派生密钥加密，设定后不要再改，
#       否则之前保存的密码会无法解密，需要重新保存一次。
WCAN_SECRET=

# 管理员密码 —— 用于清空历史记录、检查更新、重启应用等敏感操作
# 不要使用简单口令，公网上会被扫
WCAN_ADMIN_PWD=

# 对外访问端口（容器内固定 10015，一般不用改）
# PORT=10015
